# ─────────────────────────────────────────────────────────────
#  Ledgr – Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# Get these from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# sandbox | development | production
PLAID_ENV=sandbox

# Comma-separated list of Plaid products to request
# https://plaid.com/docs/api/products/
PLAID_PRODUCTS=transactions

# Comma-separated country codes
PLAID_COUNTRY_CODES=US

# Port for the Express server
PORT=3001

# Frontend origin for CORS (change for production)
FRONTEND_URL=http://localhost:5173

# ── Replica safety ────────────────────────────────────────────
# Controls whether THIS instance runs cron jobs (trial expiry,
# Plaid sync). Defaults to true so single-instance deployments
# work with no changes.
#
# When scaling to multiple replicas:
#   - Set IS_WORKER=false on all web/API instances
#   - Set IS_WORKER=true on exactly ONE dedicated worker instance
#
# This prevents every replica from running duplicate syncs and
# sending duplicate emails.
IS_WORKER=true
